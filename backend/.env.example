# ==== J.A.R.V.I.S. backend — variables de entorno de ejemplo ====
# Copia este archivo a .env (que está en .gitignore) y rellena los valores.
# NUNCA subas .env al repositorio ni pegues claves en notas de Obsidian.

# --- Servidor ---
PORT=8787
HOST=0.0.0.0
# true si el backend está detrás de un proxy/hosting (Render, Fly, Railway…)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Autenticación de la app (OBLIGATORIO) ---
# Token compartido entre la app Android y este backend. Genera uno con:
#   npm run gen-token
# y pégalo también en la app (Ajustes → Servidor). No es la clave de OpenAI.
JARVIS_CLIENT_TOKEN=

# --- Inteligencia artificial: qué proveedor usa JARVIS ---
# "auto" = Gemini, OpenAI y Llama, en ese orden, los que tengan clave. Si el primero falla por cuota
# o caída, responde el siguiente. También puedes fijar el orden: AI_PROVIDERS=gemini,llama
AI_PROVIDERS=auto
# Voz en vivo de la web: auto (Gemini Live si hay clave de Gemini, si no OpenAI) | gemini | openai | none
VOICE_PROVIDER=auto

# --- Gemini (Google AI Studio): cerebro, fotos, dictado y voz en vivo ---
# Clave de https://aistudio.google.com/apikey. SOLO aquí, en el servidor.
GEMINI_API_KEY=
# Alias que siempre apunta al Flash más reciente; puedes fijar uno concreto (p. ej. gemini-2.5-flash).
GEMINI_MODEL=gemini-flash-latest
# Vacíos = GEMINI_MODEL
GEMINI_VISION_MODEL=
GEMINI_TRANSCRIBE_MODEL=
# "auto": el servidor elige un modelo con voz en vivo de los que tu clave puede usar.
GEMINI_LIVE_MODEL=auto
# Voces: Charon, Puck, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Charon

# --- Llama (respaldo opcional), por un proveedor compatible con la API de OpenAI ---
# Groq por defecto (https://console.groq.com/keys). Otros: Meta Llama API, OpenRouter, Together…
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.groq.com/openai/v1
# "auto" elige de la lista del proveedor; "none" desactiva esa función.
LLAMA_MODEL=auto
LLAMA_VISION_MODEL=auto
LLAMA_TRANSCRIBE_MODEL=auto

# --- OpenAI (opcional: voz Realtime y chat de texto) ---
# Clave permanente: SOLO aquí, en el servidor. Nunca en la app ni en el APK.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo Realtime por defecto (el "mini" es ~3 veces más barato; ver JARVIS-KB/07-RESEARCH)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Modelos que la app puede solicitar
OPENAI_REALTIME_ALLOWED_MODELS=gpt-realtime-2.1-mini,gpt-realtime-2.1,gpt-realtime-mini,gpt-realtime
# Voces oficiales: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
OPENAI_REALTIME_VOICE=cedar
# Transcripción de tu voz para mostrarla en pantalla (coste adicional). "none" la desactiva.
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Vida del client secret efímero (10–7200 s) en el flujo "ephemeral"
REALTIME_SECRET_TTL_SECONDS=60
# Límites de seguridad de costo (contadores en memoria)
REALTIME_MAX_SESSIONS_PER_HOUR=20
REALTIME_MAX_SESSIONS_PER_DAY=60
# Modelo de texto para el chat con herramientas (API Responses)
OPENAI_TEXT_MODEL=gpt-5.4-mini
# none | minimal | low | medium | high | off (off = no enviar parámetro reasoning)
OPENAI_TEXT_REASONING_EFFORT=low
CHAT_MAX_REQUESTS_PER_DAY=500
# Visión (tarjetas, recibos, texto de documentos, describir escenas). Vacío = OPENAI_TEXT_MODEL,
# que debe aceptar imágenes. Las imágenes no se guardan en el servidor (store=false).
OPENAI_VISION_MODEL=
VISION_MAX_REQUESTS_PER_DAY=100
# Transcripción de notas de voz grabadas en la app. "none" la desactiva.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_MAX_REQUESTS_PER_DAY=100

# --- Búsqueda web ---
# "auto" usa en orden: searxng, tavily, brave, openai (si está habilitado), wikipedia
SEARCH_PROVIDERS=auto
# SearXNG autoalojado (gratis; requiere habilitar formato json en settings.yml)
SEARXNG_URL=
# Tavily (plan gratuito con créditos mensuales; requiere cuenta)
TAVILY_API_KEY=
# Brave Search API (requiere cuenta y tarjeta; ver condiciones vigentes)
BRAVE_API_KEY=
# Herramienta web_search de OpenAI (DE PAGO). Desactivada por defecto.
SEARCH_ENABLE_OPENAI=false
WIKIPEDIA_LANG=es

# --- Comercio exterior (UN Comtrade) ---
# Clave del producto gratuito "comtrade - v1" (comtradedeveloper.un.org). Estadísticas oficiales en USD
# por partida arancelaria (SA). Se envía en la cabecera Ocp-Apim-Subscription-Key, nunca en la URL.
UN_COMTRADE_API_KEY=
COMTRADE_MAX_REQUESTS_PER_DAY=200

# --- Google Maps (solo Places API (New), para verificar negocios) ---
# De pago con cuota gratuita mensual: requiere facturación en Google Cloud y activar "Places API (New)".
# Restringe la clave a esa API y, si puedes, a la IP del servidor. Los datos de Google no se guardan en el
# teléfono ni se muestran en el mapa de OpenStreetMap (condiciones de Google; ver ADR-016).
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_MAX_REQUESTS_PER_DAY=30

# --- Clips de video (OpusClip) y publicación en YouTube ---
# Clave de app.opus.pro/settings/integration-tokens (la API requiere plan Pro, Max o Business).
# YouTube se conecta DENTRO de OpusClip (Social accounts): JARVIS publica a través de OpusClip.
OPUSCLIP_API_KEY=
OPUSCLIP_MAX_PROJECTS_PER_DAY=5
OPUSCLIP_MAX_POSTS_PER_DAY=10

# --- Negocios (OpenStreetMap) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Correo o URL de contacto para el User-Agent (lo piden las políticas de uso de OSM)
OSM_CONTACT=
BUSINESS_DEFAULT_COUNTRY=cr
BUSINESS_CACHE_TTL_SECONDS=3600

# --- Protección ---
RATE_LIMIT_PER_MINUTE=60
OUTBOUND_TIMEOUT_MS=20000
