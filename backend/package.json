{
  "name": "jarvis-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de J.A.R.V.I.S.: sesiones OpenAI Realtime, chat con herramientas, búsqueda web y búsqueda de negocios (OpenStreetMap).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:live": "JARVIS_LIVE_TESTS=1 node --env-file-if-exists=.env --test --test-reporter=spec \"test/live/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 \"test/e2e/*.e2e.js\"",
    "gen-token": "node scripts/gen-token.js",
    "sync-shared": "node scripts/sync-shared.js",
    "build-globe": "python3 -I scripts/build-globe-data.py"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
