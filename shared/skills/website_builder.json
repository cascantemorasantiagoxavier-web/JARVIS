{
  "id": "website_builder",
  "name": "Creador de sitios web",
  "description": "Genera un sitio web de una página, adaptable al móvil, para tu negocio (servicios, contacto por WhatsApp/llamada/correo, horario, mapa de OpenStreetMap y datos estructurados schema.org) y lo guarda como HTML.",
  "category": "marketing",
  "exampleUtterances": [
    "hazme una página web para mi panadería",
    "crea un sitio web sencillo para mi taller",
    "genera una landing page con mi WhatsApp",
    "quiero una web de una página para mi negocio"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "business_name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 120
      },
      "description": {
        "type": "string",
        "maxLength": 600
      },
      "services": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 120
        },
        "maxItems": 20
      },
      "phone": {
        "type": "string",
        "maxLength": 30
      },
      "whatsapp": {
        "type": "string",
        "maxLength": 30
      },
      "email": {
        "type": "string",
        "maxLength": 320
      },
      "address": {
        "type": "string",
        "maxLength": 300
      },
      "hours": {
        "type": "string",
        "maxLength": 200
      },
      "color": {
        "type": "string",
        "maxLength": 7
      },
      "lat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "lon": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "save": {
        "type": "boolean"
      }
    },
    "required": [
      "business_name"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "business_name": {
        "type": "string"
      },
      "html_bytes": {
        "type": "integer",
        "minimum": 0
      },
      "preview": {
        "type": "string"
      }
    },
    "required": [
      "business_name",
      "html_bytes",
      "preview"
    ],
    "additionalProperties": true
  },
  "tools": [
    "save_document"
  ],
  "requiredPermissions": [],
  "optionalPermissions": [],
  "requiresInternet": false,
  "requiresExternalService": [],
  "optionalServices": [],
  "model": "none",
  "cost": "Sin costo.",
  "risk": "local_write",
  "limits": {
    "timeoutSeconds": 20,
    "maxToolCalls": 1
  },
  "cancellation": "Cancelable en cualquier momento (botón Detener o «cancela»). Los cambios se guardan al final: una cancelación no deja datos a medias.",
  "errorHandling": "Sin medio de contacto → se pide. Todo el texto se escapa (sin inyección de HTML).",
  "maturity": "partial",
  "missing": [
    "publicación automática en un hosting (se entrega el archivo HTML)"
  ],
  "privacy": "Se genera en el teléfono.",
  "localRoute": false,
  "testCases": [
    {
      "name": "sitio",
      "input": {
        "business_name": "Panadería La Espiga",
        "description": "Pan artesanal en Heredia",
        "services": [
          "Pan dulce",
          "Queques"
        ],
        "whatsapp": "50688887777"
      },
      "expect": [
        "partial"
      ]
    }
  ]
}
